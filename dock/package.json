{
  "name": "notations-ecosystem-dock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Visual dock for the Notations Ecosystem control plane: Kepler.gl universe map, capability graph, coordination ledger and event timeline.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "sync": "node scripts/sync-layers.mjs",
    "predev": "npm run sync",
    "dev": "vite",
    "prebuild": "npm run sync",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "npm run sync",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json --noEmit",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@kepler.gl/actions": "3.2.6",
    "@kepler.gl/components": "3.2.6",
    "@kepler.gl/reducers": "3.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.29.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "styled-components": "6.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
