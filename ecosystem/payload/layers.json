  "row_provenance": {
    "fields": [
      "provenance",
      "known_at",
      "valid_from",
      "valid_to",
      "confidence",
      "evidence"
    ],
    "required": [
      "provenance"
    ],
    "defined_in": "ecosystem/payload/provenance.mjs",
    "note": "One spelling for the estate’s central discipline. A value with no origin is a rumour; a value whose knowability is not recorded cannot be replayed as known-then."
  },
  "row_basis": {
    "capture": "Every row names a dated retrieval from the source that published it",
    "manifest": "Every row is derived from a sha256-indexed manifest entry",
    "curated": "Real data assembled by hand or scraped from a first-party file: no capture date, no digest",
    "synthetic": "Generated for demonstration. Never an observation"
  }
}
