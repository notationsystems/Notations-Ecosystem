{
  "schema": "notations.payload.layers.v1",
  "description": "Spatial and temporal layers of the Payload node cluster, rendered by the dock's Kepler.gl lens. Each row keeps its own provenance so 'is this real?' is a per-row query, and 'when was it knowable?' is a second one: provenance_fields declares which of the row provenance fields (ecosystem/payload/provenance.mjs) that layer's rows actually carry. Four layers declare only provenance because an earlier extractor flattened the upstream block; re-running extract-earth.mjs recovers known_at and must update the declaration. Layers never enter the control-plane journal.",
  "groups": {
    "facilities": "Facilities and infrastructure",
    "logistics": "Routes, corridors and chokepoints",
    "flows": "Commodity and trade flows",
    "disruptions": "Disruption events and constraints",
    "coverage": "Source coverage and archive vintages"
  },
  "layers": [
    {
      "id": "earth-facilities",
      "name": "Payload Earth facilities",
      "group": "facilities",
      "source_system": "payload-render-engine",
      "geometry": "point",
      "file": "earth-facilities.json",
      "provenance": "synthetic:demo — Payload Earth canonical demo corpus (every row labelled)",
      "real": false,
      "default_visible": true,
      "kepler": {
        "type": "point",
        "columns": {
          "lat": "latitude",
          "lng": "longitude"
        },
        "colorField": {
          "name": "kind",
          "type": "string"
        },
        "sizeField": {
          "name": "importance",
          "type": "real"
        },
        "label": "name",
        "radiusRange": [
          4,
          18
        ],
        "tooltip": [
          "name",
          "kind",
          "country",
          "status",
          "capacity",
          "provenance",
          "known_at"
        ]
      },
      "provenance_fields": [
        "provenance",
        "known_at",
        "confidence"
      ],
      "basis": "synthetic"
    },
    {
      "id": "earth-chokepoints",
      "name": "Chokepoints and standing constraints",
