# Every variable the control plane reads, in the order it needs them. Defaults are the
# ones readConfig() applies; a value shown here is the default unless the comment says
# otherwise. `node security/bootstrap.mjs --dir ./deploy --print-env` writes a working
# set of these for a real deployment.

# ── Listener ───────────────────────────────────────────────────────────────────
# Binds to loopback by default. Serving plaintext on any other address is refused at
# boot: set the TLS pair below, or acknowledge an upstream terminator.
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8787

# ── Transport ──────────────────────────────────────────────────────────────────
# Paths to a certificate and key, to terminate TLS here. Both or neither.
CONTROL_PLANE_TLS_CERT=
CONTROL_PLANE_TLS_KEY=
# Set to 1 only when a trusted reverse proxy terminates TLS in front of this process.
# It is an assertion about your deployment, not a way to skip encryption.
CONTROL_PLANE_TRUST_PROXY_TLS=0

# ── Identity ───────────────────────────────────────────────────────────────────
# Preferred: one credential per principal, digests only, issued with
# `node control-plane/src/security/cli.js issue`. The file holds no usable secret.
CONTROL_PLANE_PRINCIPALS_FILE=
# Fallback for local development only. One token that holds every role and may claim
# any actor identity, so the journal's actor is a claim rather than a fact. The plane
# warns at boot and reports it as weak identity posture.
NOTATIONS_CONTROL_PLANE_TOKEN=

# ── Journal ────────────────────────────────────────────────────────────────────
# Durable local or managed storage. Never a synchronised desktop folder or /tmp.
CONTROL_PLANE_JOURNAL_PATH=data/control-plane.jsonl
# The rollback anchor beside it: what turns silent history loss into a loud failure.
CONTROL_PLANE_ANCHOR=1

# ── Signing ────────────────────────────────────────────────────────────────────
# Ed25519 over each record hash, so rewriting history needs the key and not just write
# access to a file.
CONTROL_PLANE_SIGNING=1
# Unset, the key store is derived from the journal path — the key lives beside the
# history it signs, as the rollback anchor already does. Set it only to put the key
# somewhere else deliberately; a relative path here is resolved against the working
# directory, and a key that moves with the operator is a key the next reader cannot find.
CONTROL_PLANE_KEYSTORE=data/keystore.json
# Base64 32-byte key encryption key. Without it the signing key sits on disk in
# plaintext and the plane says so at boot. `security/cli.js kek generate` mints one;
# keep it in a secret manager, never in this file.
CONTROL_PLANE_KEK=
# Refuse an unsigned record on read. Requires CONTROL_PLANE_SIGNING=1 — the plane
# refuses to start on the combination that would report a control it cannot run.
CONTROL_PLANE_REQUIRE_SIGNATURES=0

# ── Browser access ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the private API from a browser. Leave empty
# for same-origin docks or server-to-server callers.
CONTROL_PLANE_ALLOWED_ORIGINS=

# ── Abuse and freshness ────────────────────────────────────────────────────────
# Per process, by design: the plane is a single writer. A multi-instance deployment
# carries the same limits at its shared edge.
CONTROL_PLANE_READS_PER_MINUTE=600
CONTROL_PLANE_COMMANDS_PER_MINUTE=60
CONTROL_PLANE_AUTH_FAILURES_PER_MINUTE=10
CONTROL_PLANE_LOCKOUT_SECONDS=300
# How old a command's submittedAt may be before it is refused as a replay.
CONTROL_PLANE_MAX_COMMAND_AGE_S=900
# Server-side cap on one page of GET /v1/events.
CONTROL_PLANE_EVENTS_LIMIT=500

# ── Diagnostics ────────────────────────────────────────────────────────────────
# Emit debug-severity security events. Sources stay pseudonymised either way.
CONTROL_PLANE_DEBUG_SECURITY_LOG=0
