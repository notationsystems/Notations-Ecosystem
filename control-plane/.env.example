# HTTP listener. The service binds to loopback by default.
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8787

# Required for every control-plane route except /health. Generate a unique,
# high-entropy value in your deployment secret manager; never commit it.
NOTATIONS_CONTROL_PLANE_TOKEN=

# Hash-linked coordination journal. Keep on durable local or managed storage,
# never in a synchronised desktop folder or a temporary directory.
CONTROL_PLANE_JOURNAL_PATH=data/control-plane.jsonl
# Rebuildable internal index derived solely from the hash-linked journal.
CONTROL_PLANE_INDEX_PATH=data/control-plane-index.json

# Required by direct, internal profile and Fabric sync operations. This is an
# audit actor identity, not a credential. Use a human or workload identity.
NOTATIONS_INTERNAL_ACTOR=

# Comma-separated origins allowed to call the private API from a browser.
# Leave empty for same-origin docks or server-to-server callers.
CONTROL_PLANE_ALLOWED_ORIGINS=

# The one trusted Payload Terminal origin the adapter may probe. Remote
# origins must use HTTPS; loopback HTTP is accepted for local development.
PAYLOAD_TERMINAL_URL=
PAYLOAD_TERMINAL_TIMEOUT_MS=5000

# Internal security attesters only. A JSON object mapping a collector id to
# its base64url Ed25519 public-key x-coordinate, for example:
# {"security-collector-1":"<base64url-ed25519-public-key>"}
# The Control Plane verifies signatures with these public keys; private keys
# never enter this process or its journal.
NOTATIONS_SECURITY_ATTESTERS=
